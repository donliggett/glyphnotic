// Glyphnotic: shared shader code, included by the pass effects.
//
// Every pass draws one full-target sprite (uv 0..1). A fragment finds its
// texel from the uv and the target size, and reads inputs with Load, so no
// filtering or orientation differences between Direct3D and OpenGL apply.

uniform float4x4 ViewProj;

struct VertData {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv = v_in.uv;
	return v_out;
}

// The texel this fragment covers in a target of the given size.
int2 texel_of(float2 uv, float2 size)
{
	return int2(floor(uv * size));
}

float srgb_decode_channel(float u)
{
	return (u <= 0.04045) ? (u / 12.92) : pow((u + 0.055) / 1.055, 2.4);
}

float3 srgb_decode(float3 v)
{
	return float3(srgb_decode_channel(v.r), srgb_decode_channel(v.g), srgb_decode_channel(v.b));
}

float srgb_encode_channel(float u)
{
	return (u <= 0.0031308) ? (12.92 * u) : (1.055 * pow(u, 1.0 / 2.4) - 0.055);
}

float3 srgb_encode(float3 v)
{
	return float3(srgb_encode_channel(v.r), srgb_encode_channel(v.g), srgb_encode_channel(v.b));
}

float cbrt_pos(float x)
{
	return pow(max(x, 0.0), 1.0 / 3.0);
}

// Linear sRGB to OKLab (Ottosson, 2020).
float3 linear_to_oklab(float3 c)
{
	float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
	float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
	float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
	l = cbrt_pos(l);
	m = cbrt_pos(m);
	s = cbrt_pos(s);
	return float3(0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
		      1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
		      0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);
}

// OKLab to linear sRGB (not clipped).
float3 oklab_to_linear(float3 c)
{
	float l = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
	float m = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
	float s = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;
	l = l * l * l;
	m = m * m * m;
	s = s * s * s;
	return float3(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
		      -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
		      -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}
