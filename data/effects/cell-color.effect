// Glyphnotic pass: Color (cell resolution, double width).
//
// The target is 2*cellsX by cellsY: texel (2*cx, cy) holds cell (cx, cy)'s
// text color and texel (2*cx + 1, cy) its background color, so one pass
// writes both without multiple render targets.
//
// Mosaic: text = mean of the shown glyph's lit samples, background = mean of
// its unlit samples; a side with no samples takes the other side's color.
//
// Output: OKLab in rgb; a = 1 for an opaque cell, 0 for a transparent one.

#include "cells.effect"

uniform texture2d atlas;
uniform texture2d scores; // Score pass output; .y is the shown glyph
uniform texture2d stats;  // Cell stats output; .a is the mean alpha
uniform float keep_transparency;

float4 PSColor(VertData v_in) : TARGET
{
	int2 t = texel_of(v_in.uv, cell_count * float2(2.0, 1.0));
	int2 cell = int2(t.x / 2, t.y);
	bool want_background = (t.x - cell.x * 2) == 1;
	int2 base = cell * int2(8, 16);
	bool any_opaque = cell_has_opaque(base);
	float3 shift = cell_shift(base, any_opaque);
	int g = int(scores.Load(int3(cell, 0)).y + 0.5);

	float3 s_on = float3(0.0, 0.0, 0.0);
	float n_on = 0.0;
	float3 tot = float3(0.0, 0.0, 0.0);
	float ntot = 0.0;
	for (int ly = 0; ly < 16; ly++) {
		for (int lx = 0; lx < 8; lx++) {
			float4 s = load_sample(base, lx, ly);
			float w = sample_weight(s.a, any_opaque);
			float3 y = (s.rgb - shift) * w;
			tot += y;
			ntot += w;
			if (atlas.Load(int3(ly * 8 + lx, g, 0)).r > 0.5) {
				s_on += y;
				n_on += w;
			}
		}
	}
	float3 s_off = tot - s_on;
	float n_off = ntot - n_on;

	float3 text = (n_on > 0.0) ? (s_on / n_on) : (s_off / max(n_off, 1.0));
	float3 back = (n_off > 0.0) ? (s_off / n_off) : text;
	float3 lab = shift + (want_background ? back : text);

	float alpha = stats.Load(int3(cell, 0)).a;
	float opaque = (keep_transparency > 0.5 && alpha < 0.5) ? 0.0 : 1.0;
	return float4(lab, opaque);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSColor(v_in);
	}
}
